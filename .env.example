# Set ENVIRONMENT=production to enforce strong secrets and secure cookies
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=library
DB_USER=root
DB_PASSWORD=

# REQUIRED in production (>= 32 random chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Comma-separated explicit origins ("*" is rejected)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# COOKIE_SECURE defaults to true in production, false otherwise (uncomment to override)
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=pdf,epub,txt,md

RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=100/minute
